local function LoadScript()
    local url = Scripts[gameId]
    if not url then
        warn("[Phantom Hub] No script found for GameId: " .. tostring(gameId))
        return
    end
    local ok, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    if not ok then
        warn("[Phantom Hub] Script error: " .. tostring(err))
    end
end

